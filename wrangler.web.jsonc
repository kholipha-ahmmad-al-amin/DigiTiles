{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digitiles-web",
  "account_id": "f097993c07d8490e4744dfeac7519066",
  "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true },
    "traces": { "enabled": true, "persist": true }
  },
  "assets": {
    "directory": ".cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  }
}
